# Banco de dados
DB_NAME=multi_empresas_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Django
# Gere uma chave única para cada ambiente antes de publicar em produção.
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
# Separados por vírgula, sem espaços
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para CSRF (separadas por vírgula). Necessário em produção com domínio customizado.
CSRF_TRUSTED_ORIGINS=

# Primeiro acesso
# Obrigatório quando ainda não existe Super Admin no banco.
ADMIN_PASSWORD=change-this-initial-admin-password

# Segurança HTTPS
# Em desenvolvimento local, mantenha False/0.
# Em produção com HTTPS, configure True e HSTS conforme sua infraestrutura.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# E-mail SMTP
# Também pode ser configurado pela interface do sistema.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Localização
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Sao_Paulo
